---
import type { Supplier } from '@/data/minimalista';

interface Props {
  suppliers: Supplier[];
}

const { suppliers } = Astro.props;
const maxKm = 100;
---

<section id="produttori" class="suppliers" aria-labelledby="produttori-title">
  <div class="m-wrap layout">
    <header>
      <h2 id="produttori-title" class="m-label">Produttori</h2>
      <p class="intro">Ogni ingrediente ha un nome e un indirizzo.</p>
    </header>

    <ul role="list" class="list">
      {
        suppliers.map((s) => (
          <li class="row m-reveal" style={`--km:${s.km / maxKm}`}>
            <span class="product">{s.product}</span>
            <span class="name">
              {s.name}, {s.place}
            </span>
            <span class="km">{s.km} km</span>
            <span class="bar" aria-hidden="true" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .suppliers {
    padding-block: var(--m-section);
    border-top: 1px solid var(--m-line);
  }

  .layout {
    display: grid;
    gap: 2.5rem;
  }

  .intro {
    margin-top: 1rem;
    font-size: clamp(1.75rem, 8vw, 2.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.045em;
    max-width: 16ch;
  }

  .list {
    border-top: 1px solid var(--m-ink);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1rem;
    padding-block: 1.1rem 1.4rem;
    border-bottom: 1px solid var(--m-line);
  }

  .product {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .name {
    grid-row: 2;
    font-size: 0.8125rem;
    color: var(--m-muted);
  }

  .km {
    grid-row: span 2;
    align-self: center;
    font-variant-numeric: tabular-nums;
    font-size: 0.875rem;
  }

  /* Barra proporzionale alla distanza: rende visibile il "meno di cento chilometri". */
  .bar {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: calc(var(--km) * 100%);
    background: var(--m-accent);
  }

  @media (min-width: 48rem) {
    .layout {
      grid-template-columns: 1fr 2fr;
      gap: 4rem;
    }

    .row {
      grid-template-columns: 10rem 1fr auto;
      align-items: baseline;
    }

    .name {
      grid-row: auto;
      font-size: 0.875rem;
    }

    .km {
      grid-row: auto;
    }
  }
</style>
