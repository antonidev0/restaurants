---
import type { AestheticContent } from '@/data/aesthetic';
import Illustration from './Illustration.astro';

interface Props {
  moments: AestheticContent['moments'];
  quote: AestheticContent['quote'];
}

const { moments, quote } = Astro.props;
---

<section id="momenti" class="moments" aria-labelledby="momenti-title">
  <div class="a-wrap">
    <p class="a-eyebrow">La giornata</p>
    <h2 id="momenti-title" class="a-title">Tre momenti, <em>un giardino</em></h2>

    <ol role="list" class="list">
      {
        moments.map((moment) => (
          <li class:list={['item', `mood-${moment.mood}`]}>
            <Illustration mood={moment.mood} class="icon" />
            <div>
              <p class="time">{moment.time}</p>
              <h3 class="title">{moment.title}</h3>
              <p class="text">{moment.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <figure class="quote">
      <blockquote>
        <p>“{quote.text}”</p>
      </blockquote>
      <figcaption>— {quote.author}</figcaption>
    </figure>
  </div>
</section>

<style>
  .moments {
    padding-block: 3rem 4rem;
  }

  .list {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .item {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem 1rem 1rem;
    border-radius: 999px 1.75rem 1.75rem 999px;
    background: var(--mood);
  }

  .item :global(.icon) {
    width: 4.5rem;
    height: 4.5rem;
    padding: 0.4rem;
    border-radius: 50%;
    background: var(--a-paper);
  }

  .time {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .title {
    font-family: var(--a-serif);
    font-size: 1.6rem;
    font-weight: 500;
    font-style: italic;
    line-height: 1.1;
  }

  .text {
    font-size: 0.9rem;
    color: var(--a-ink);
    opacity: 0.8;
  }

  .quote {
    margin-top: 4rem;
    text-align: center;
  }

  blockquote p {
    font-family: var(--a-serif);
    font-size: clamp(1.75rem, 7vw, 2.75rem);
    font-style: italic;
    line-height: 1.25;
    max-width: 26ch;
    margin-inline: auto;
  }

  figcaption {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--a-muted);
  }

  @media (min-width: 48rem) {
    .list {
      grid-template-columns: repeat(3, 1fr);
    }

    .item {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding: 2rem 1.5rem 2.5rem;
      border-radius: var(--a-arch);
    }

    .item :global(.icon) {
      width: 7rem;
      height: 7rem;
    }
  }
</style>
