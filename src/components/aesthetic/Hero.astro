---
import Illustration from './Illustration.astro';

interface Props {
  name: string;
  eyebrow: string;
  tagline: string;
  stickers: string[];
}

const { name, eyebrow, tagline, stickers } = Astro.props;
const [first, ...rest] = name.split(' ');
const stickerMoods = ['limone', 'salvia', 'lavanda'] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="a-wrap grid">
    <div class="copy">
      <p class="a-eyebrow eyebrow">
        <span class="spark" aria-hidden="true">✦</span>
        {eyebrow}
        <span class="spark" aria-hidden="true">✦</span>
      </p>
      <h1 id="hero-title" class="a-title title">
        {first} <em>{rest.join(' ')}</em>
      </h1>
      <p class="tagline">{tagline}</p>
      <div class="buttons">
        <a class="a-btn a-btn--dark" href="#visita">Prenota un tavolo</a>
        <a class="a-btn" href="#momenti">Sfoglia il menu</a>
      </div>
    </div>

    <div class="visual">
      <div class="arch" aria-hidden="true">
        <span class="sun"></span>
        <svg class="birds" viewBox="0 0 60 20" fill="none" stroke="#4a3530" stroke-width="1.2" stroke-linecap="round">
          <path d="M2 10q4-5 8 0q4-5 8 0" />
          <path d="M30 6q3-4 6 0q3-4 6 0" />
        </svg>
        <svg class="waves" viewBox="0 0 400 120" preserveAspectRatio="none">
          <path class="wave wave--1" d="M0 30 Q50 15 100 30 T200 30 T300 30 T400 30 T500 30 T600 30 T700 30 T800 30 V120 H0Z" />
          <path class="wave wave--2" d="M0 55 Q50 40 100 55 T200 55 T300 55 T400 55 T500 55 T600 55 T700 55 T800 55 V120 H0Z" />
          <path class="wave wave--3" d="M0 80 Q50 68 100 80 T200 80 T300 80 T400 80 T500 80 T600 80 T700 80 T800 80 V120 H0Z" />
        </svg>
      </div>

      <Illustration mood="limone" class="lemon lemon--a" />
      <Illustration mood="limone" class="lemon lemon--b" />

      <ul role="list" class="stickers">
        {
          stickers.map((sticker, i) => (
            <li class:list={['sticker', `sticker--${i + 1}`, `mood-${stickerMoods[i % stickerMoods.length]}`]}>{sticker}</li>
          ))
        }
      </ul>

      <svg class="badge" viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <path id="badge-circle" d="M50 50m-36 0a36 36 0 1 1 72 0a36 36 0 1 1-72 0" />
        </defs>
        <circle cx="50" cy="50" r="48" fill="#fffaf4" />
        <text font-size="9.5" letter-spacing="2.6">
          <textPath href="#badge-circle">LIMONI · SOLE · MARE · AMORE ·</textPath>
        </text>
        <text x="50" y="57" text-anchor="middle" font-size="22" fill="#d4775a">✿</text>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 0.5rem 3rem;
    overflow: hidden;
  }

  .grid {
    display: grid;
    gap: 2.75rem;
  }

  .copy {
    display: grid;
    gap: 1.1rem;
    text-align: center;
    justify-items: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .spark {
    font-size: 0.7rem;
  }

  .title {
    font-size: clamp(3.4rem, 16vw, 7rem);
    line-height: 0.92;
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .title em {
    display: block;
  }

  .tagline {
    max-width: 26ch;
    font-family: var(--a-serif);
    font-size: 1.4rem;
    font-style: italic;
    line-height: 1.3;
    color: var(--a-muted);
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both;
  }

  .buttons {
    display: grid;
    gap: 0.6rem;
    width: 100%;
    max-width: 22rem;
    margin-top: 0.5rem;
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s both;
  }

  .visual {
    position: relative;
    width: min(88%, 24rem);
    margin-inline: auto;
    animation: rise 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s both;
  }

  .arch {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: var(--a-arch);
    overflow: hidden;
    background: linear-gradient(180deg, #fbe3cf 0%, #f8c3a6 40%, #f3a98c 64%);
    box-shadow:
      inset 0 0 0 10px var(--a-paper),
      0 30px 60px -30px rgb(212 119 90 / 0.55);
  }

  .sun {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 48%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #fff6d6, #f6d35b 72%);
    box-shadow: 0 0 60px 10px rgb(246 211 91 / 0.45);
    transform: translate(-50%, -50%);
    animation: sunrise 7s ease-in-out infinite alternate;
  }

  .birds {
    position: absolute;
    top: 18%;
    left: 18%;
    width: 22%;
    opacity: 0.7;
    animation: a-float 6s ease-in-out infinite;
  }

  /* Tre onde che scorrono a velocità diverse: un parallasse leggero. */
  .waves {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 200%;
    height: 40%;
  }

  .wave {
    animation: drift linear infinite;
  }

  .wave--1 {
    fill: #cfdcc3;
    animation-duration: 14s;
  }

  .wave--2 {
    fill: #b9cfb0;
    animation-duration: 10s;
    animation-direction: reverse;
  }

  .wave--3 {
    fill: #a9c29a;
    animation-duration: 18s;
  }

  .visual :global(.lemon) {
    position: absolute;
    animation: a-float 5s ease-in-out infinite;
  }

  .visual :global(.lemon--a) {
    top: 4%;
    left: -12%;
    width: 36%;
    rotate: -24deg;
  }

  .visual :global(.lemon--b) {
    bottom: -4%;
    right: -10%;
    width: 30%;
    rotate: 160deg;
    animation-delay: -2.5s;
  }

  .sticker {
    position: absolute;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--mood);
    font-family: var(--a-serif);
    font-size: 1rem;
    font-style: italic;
    white-space: nowrap;
    box-shadow: 0 8px 18px -10px rgb(74 53 48 / 0.45);
  }

  .sticker--1 {
    top: 30%;
    right: -8%;
    rotate: 6deg;
  }

  .sticker--2 {
    top: 58%;
    left: -10%;
    rotate: -7deg;
  }

  .sticker--3 {
    bottom: 10%;
    left: 8%;
    rotate: 3deg;
  }

  .badge {
    position: absolute;
    right: -1.5rem;
    top: -1.5rem;
    width: 6rem;
    fill: var(--a-ink);
    font-family: var(--a-sans);
    font-weight: 500;
    animation: spin 18s linear infinite;
    filter: drop-shadow(0 8px 14px rgb(74 53 48 / 0.2));
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @keyframes sunrise {
    to {
      transform: translate(-50%, -36%);
    }
  }

  @keyframes drift {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: 2rem 5rem;
    }

    .grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
      gap: 4rem;
    }

    .copy {
      text-align: left;
      justify-items: start;
    }

    .title em {
      display: inline;
    }

    .buttons {
      display: flex;
      max-width: none;
    }

    .badge {
      width: 7.5rem;
      right: -2.5rem;
    }
  }
</style>
