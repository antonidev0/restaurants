---
import type { AestheticContent } from '@/data/aesthetic';
import Illustration from './Illustration.astro';

interface Props {
  story: AestheticContent['story'];
  description: string;
}

const { story, description } = Astro.props;
---

<section id="storia" class="story" aria-labelledby="storia-title">
  <div class="a-wrap layout">
    <div class="polaroids a-reveal" aria-hidden="true">
      {
        story.polaroids.map((p, i) => (
          <figure class:list={['polaroid', `polaroid--${i + 1}`, `mood-${p.mood}`]}>
            <div class="photo">
              <Illustration mood={p.mood} class="photo-art" />
            </div>
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))
      }
      <span class="tape" />
    </div>

    <div class="copy">
      <p class="a-eyebrow">La nostra storia</p>
      <h2 id="storia-title" class="a-title">{story.title}</h2>
      <p class="lead">{description}</p>
      {story.paragraphs.map((p) => <p class="text">{p}</p>)}
      <p class="signature">{story.signature}</p>
    </div>
  </div>
</section>

<style>
  .story {
    padding-block: 2rem 4rem;
  }

  .layout {
    display: grid;
    gap: 3rem;
  }

  /* Tre polaroid sovrapposte, leggermente ruotate come su un frigorifero. */
  .polaroids {
    position: relative;
    height: 22rem;
    max-width: 22rem;
    width: 100%;
    margin-inline: auto;
  }

  .polaroid {
    position: absolute;
    width: 62%;
    padding: 0.6rem 0.6rem 0;
    background: var(--a-paper);
    border-radius: 4px;
    box-shadow: 0 18px 30px -18px rgb(74 53 48 / 0.5);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .polaroid--1 {
    top: 0;
    left: 0;
    rotate: -8deg;
  }

  .polaroid--2 {
    top: 2.5rem;
    right: 0;
    rotate: 7deg;
    z-index: 1;
  }

  .polaroid--3 {
    bottom: 0;
    left: 18%;
    rotate: -2deg;
    z-index: 2;
  }

  .polaroid:hover {
    transform: scale(1.05);
    z-index: 3;
  }

  .photo {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 2px;
    background: linear-gradient(160deg, var(--mood), var(--mood-2));
  }

  .photo :global(.photo-art) {
    width: 62%;
  }

  figcaption {
    padding: 0.55rem 0 0.7rem;
    font-family: var(--a-serif);
    font-size: 1.05rem;
    font-style: italic;
    text-align: center;
  }

  .tape {
    position: absolute;
    z-index: 4;
    top: 1.75rem;
    right: 22%;
    width: 4.5rem;
    height: 1.4rem;
    background: rgb(221 210 234 / 0.75);
    rotate: 20deg;
  }

  .copy {
    display: grid;
    gap: 1.25rem;
  }

  .lead {
    font-family: var(--a-serif);
    font-size: 1.45rem;
    font-style: italic;
    line-height: 1.4;
  }

  .text {
    color: var(--a-muted);
    line-height: 1.7;
  }

  .signature {
    margin-top: 0.5rem;
    font-family: var(--a-serif);
    font-size: 1.3rem;
    font-style: italic;
    color: var(--a-terracotta);
  }

  @media (min-width: 48rem) {
    .layout {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 5rem;
    }

    .polaroids {
      height: 28rem;
      max-width: 28rem;
    }
  }
</style>
