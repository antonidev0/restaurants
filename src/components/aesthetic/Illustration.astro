---
/**
 * Piccole illustrazioni vettoriali a tratto morbido.
 * Sostituiscono le fotografie e mantengono la pagina leggera e senza dipendenze esterne.
 */
import type { Mood } from '@/data/aesthetic';

interface Props {
  mood: Mood;
  class?: string;
}

const { mood, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 120 120" fill="none" aria-hidden="true" stroke="#4a3530" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
  {
    mood === 'limone' && (
      <g>
        <path d="M30 70c0-20 17-36 38-36 14 0 22 8 22 8s6 8 6 22c0 21-16 38-36 38-14 0-22-8-22-8s-8-8-8-24Z" fill="#f6d35b" />
        <path d="M88 40c4-4 9-5 12-4-1 4-4 8-9 9" fill="#f6d35b" />
        <path d="M86 38c2-10 10-16 20-16-2 10-9 16-20 16Z" fill="#a9c29a" />
        <path d="M44 64c6-8 16-12 26-12" opacity=".5" />
      </g>
    )
  }
  {
    mood === 'pesca' && (
      <g>
        <ellipse cx="60" cy="72" rx="44" ry="16" fill="#fffaf4" />
        <ellipse cx="60" cy="70" rx="30" ry="9" fill="#f3a98c" />
        <path d="M38 66c6-6 14 4 22-2s14 4 22-2" />
        <path d="M44 72c6-4 12 2 18-2s12 2 16-1" />
        <circle cx="52" cy="62" r="4" fill="#e85d4a" />
        <circle cx="70" cy="64" r="3.5" fill="#f1cf63" />
        <path d="M84 40l10-14M92 42l10-14" />
      </g>
    )
  }
  {
    mood === 'salvia' && (
      <g>
        <path d="M60 100V48" />
        <path d="M60 78c-18 0-28-12-28-26 16 0 28 10 28 26Z" fill="#a9c29a" />
        <path d="M60 64c18 0 28-12 28-26-16 0-28 10-28 26Z" fill="#cfdcc3" />
        <circle cx="60" cy="38" r="9" fill="#f7cdb6" />
        <circle cx="60" cy="38" r="3" fill="#f1cf63" />
      </g>
    )
  }
  {
    mood === 'lavanda' && (
      <g>
        <path d="M38 30h44l-6 40a16 16 0 0 1-32 0l-6-40Z" fill="#fffaf4" />
        <path d="M41 46h38l-3 24a13 13 0 0 1-32 0l-3-24Z" fill="#f3a98c" />
        <path d="M60 86v14M46 100h28" />
        <circle cx="72" cy="38" r="8" fill="#f6d35b" />
        <path d="M50 22c2-6 6-8 10-8" />
        <circle cx="50" cy="56" r="2" fill="#fffaf4" stroke="none" />
        <circle cx="62" cy="62" r="1.6" fill="#fffaf4" stroke="none" />
      </g>
    )
  }
</svg>
