---
import type { Contact, OpeningHours } from '@/types/restaurant';
import type { AestheticContent } from '@/data/aesthetic';
import { toTelHref } from '@/utils/format';

interface Props {
  hours: OpeningHours[];
  contact: Contact;
  directions: AestheticContent['directions'];
}

const { hours, contact, directions } = Astro.props;
const mapsHref = `https://maps.google.com/?q=${encodeURIComponent(`${contact.address}, ${contact.city}`)}`;
---

<section id="visita" class="visit" aria-labelledby="visita-title">
  <div class="a-wrap">
    <div class="card a-reveal">
      <span class="sun" aria-hidden="true"></span>
      <p class="a-eyebrow">Vieni a trovarci</p>
      <h2 id="visita-title" class="a-title">Ti teniamo <em>un posto</em> all’ombra</h2>

      <dl class="hours">
        {
          hours.map((row) => (
            <div class="row">
              <dt>{row.days}</dt>
              <dd>{row.hours}</dd>
            </div>
          ))
        }
      </dl>

      <div class="actions">
        <a class="a-btn a-btn--dark" href={toTelHref(contact.phone)}>Chiama {contact.phone}</a>
        <a class="a-btn" href={`mailto:${contact.email}`}>Scrivi una mail</a>
      </div>
    </div>

    <div class="where">
      <address class="address">
        <span class="pin" aria-hidden="true">✿</span>
        {contact.address}<br />
        {contact.city}
      </address>

      <ul role="list" class="directions">
        {
          directions.map((d) => (
            <li>
              <strong>{d.label}</strong>
              <span>{d.detail}</span>
            </li>
          ))
        }
      </ul>

      <a class="maps" href={mapsHref} rel="noopener noreferrer" target="_blank">Apri in Mappe ↗</a>
    </div>
  </div>
</section>

<style>
  .visit {
    padding-block: 2rem 4rem;
  }

  .card {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: 3.5rem 1.5rem 2rem;
    text-align: center;
    justify-items: center;
    border-radius: var(--a-arch);
    background: linear-gradient(180deg, var(--a-pesca), var(--a-lavanda));
    overflow: hidden;
    isolation: isolate;
  }

  .sun {
    position: absolute;
    z-index: -1;
    top: -4rem;
    left: 50%;
    width: 12rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #fff6d6, rgb(246 211 91 / 0.4) 60%, transparent 70%);
    transform: translateX(-50%);
  }

  .hours {
    display: grid;
    gap: 0.5rem;
    width: 100%;
    max-width: 22rem;
    margin-top: 0.5rem;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1.1rem;
    border-radius: 999px;
    background: rgb(255 250 244 / 0.75);
    font-size: 0.9rem;
  }

  dt {
    font-weight: 500;
  }

  .actions {
    display: grid;
    gap: 0.6rem;
    width: 100%;
    max-width: 22rem;
  }

  .where {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
    padding-inline: 0.5rem;
  }

  .address {
    font-family: var(--a-serif);
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1.3;
  }

  .pin {
    display: block;
    color: var(--a-terracotta);
    font-style: normal;
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .directions {
    display: grid;
    gap: 0.5rem;
  }

  .directions li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed rgb(74 53 48 / 0.2);
    font-size: 0.9rem;
  }

  .directions strong {
    font-weight: 500;
  }

  .directions span {
    color: var(--a-muted);
    text-align: right;
  }

  .maps {
    width: fit-content;
    font-family: var(--a-serif);
    font-size: 1.2rem;
    font-style: italic;
    color: var(--a-terracotta);
  }

  @media (min-width: 48rem) {
    .visit .a-wrap {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      gap: 4rem;
    }

    .card {
      padding: 5rem 3rem 3.5rem;
    }

    .where {
      margin-top: 0;
    }
  }
</style>
