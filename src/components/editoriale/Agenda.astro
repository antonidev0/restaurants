---
import type { EditorialeContent } from '@/data/editoriale';

interface Props {
  agenda: EditorialeContent['agenda'];
}

const { agenda } = Astro.props;
---

<section id="agenda" class="agenda" aria-labelledby="agenda-title">
  <div class="e-wrap">
    <div class="e-section-head">
      <h2 id="agenda-title">Appuntamenti della settimana</h2>
      <span>Pagina 6</span>
    </div>

    <ul role="list" class="list">
      {
        agenda.map((item) => (
          <li class="item">
            <span class="day">{item.day}</span>
            <div>
              <h3 class="title">{item.title}</h3>
              <p class="text">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .agenda {
    padding-block: 2rem 3.5rem;
  }

  .e-section-head h2 {
    font: inherit;
  }

  .list {
    display: grid;
  }

  .item {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    align-items: center;
    padding-block: 1rem;
    border-bottom: 1px solid var(--e-hair);
  }

  /* Il giorno come un timbro: riquadro rosso con testo mono. */
  .day {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border: 2px solid var(--e-red);
    color: var(--e-red);
    font-family: var(--e-mono);
    font-size: 0.95rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    rotate: -4deg;
  }

  .item:nth-child(even) .day {
    rotate: 3deg;
  }

  .title {
    font-family: var(--e-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .text {
    font-size: 0.95rem;
    color: var(--e-muted);
  }

  @media (min-width: 48rem) {
    .list {
      grid-template-columns: repeat(4, 1fr);
    }

    .item {
      grid-template-columns: 1fr;
      align-items: start;
      padding: 1.5rem 1.25rem;
      border-bottom: 0;
    }

    .item:first-child {
      padding-left: 0;
    }

    .item + .item {
      border-left: 1px solid var(--e-hair);
    }

    .day {
      width: 4rem;
    }
  }
</style>
