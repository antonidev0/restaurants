---
import type { EditorialeContent } from '@/data/editoriale';

interface Props {
  feature: EditorialeContent['feature'];
}

const { feature } = Astro.props;
const [first, ...rest] = feature.body;
---

<article id="intervista" class="interview" aria-labelledby="intervista-title">
  <div class="e-wrap">
    <div class="e-section-head">
      <span>{feature.kicker}</span>
      <span>Pagina 2</span>
    </div>

    <header class="head">
      <h2 id="intervista-title" class="title">{feature.title}</h2>
      <p class="byline">{feature.byline}</p>
    </header>

    <div class="layout">
      <div class="body">
        <p class="dropcap">{first}</p>
        <aside class="pull" aria-label="Citazione">
          <p>«{feature.pullQuote}»</p>
        </aside>
        {rest.map((p) => <p>{p}</p>)}

        <div class="qa">
          {
            feature.qa.map((item) => (
              <div class="qa-item">
                <p class="q">{item.q}</p>
                <p class="a">{item.a}</p>
              </div>
            ))
          }
        </div>
      </div>

      <aside class="factsheet" aria-labelledby="scheda-title">
        <div class="portrait" aria-hidden="true">
          <svg viewBox="0 0 120 140" fill="none" stroke="currentColor" stroke-width="1.2">
            <defs>
              <pattern id="portrait-hatch" width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="3" stroke="currentColor" stroke-width="0.7" />
              </pattern>
            </defs>
            <rect x="1" y="1" width="118" height="138" fill="url(#portrait-hatch)" opacity="0.35" stroke="none" />
            <!-- Cappello da chef -->
            <path d="M40 46c-10 0-14-14-4-19 2-10 16-14 24-6 8-8 22-4 24 6 10 5 6 19-4 19Z" fill="var(--e-paper)" />
            <path d="M42 46h36v10H42z" fill="var(--e-paper)" />
            <!-- Volto -->
            <ellipse cx="60" cy="74" rx="17" ry="20" fill="var(--e-paper)" />
            <path d="M53 72h2M65 72h2M56 84q4 3 8 0" />
            <!-- Spalle e grembiule -->
            <path d="M24 139c2-22 16-32 36-32s34 10 36 32Z" fill="var(--e-paper)" />
            <path d="M48 109v30M72 109v30M48 120h24" />
          </svg>
        </div>
        <p id="scheda-title" class="factsheet-title">Scheda</p>
        <dl>
          {
            feature.factsheet.map((f) => (
              <div class="fact">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</article>

<style>
  .interview {
    padding-block: 2rem 3.5rem;
  }

  .head {
    padding-block: 1.75rem 1.5rem;
  }

  .title {
    font-family: var(--e-display);
    font-size: clamp(2rem, 8.5vw, 4.25rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.05;
  }

  .byline {
    margin-top: 1rem;
    font-family: var(--e-mono);
    font-size: 0.75rem;
    color: var(--e-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .layout {
    display: grid;
    gap: 2rem;
  }

  .body {
    font-size: 1.05rem;
    line-height: 1.65;
    hyphens: auto;
  }

  .body > p + p {
    margin-top: 1rem;
    text-indent: 1.5em;
  }

  .dropcap::first-letter {
    float: left;
    margin: 0.08em 0.1em 0 0;
    font-family: var(--e-display);
    font-size: 4.6em;
    font-weight: 900;
    line-height: 0.8;
    color: var(--e-red);
  }

  .pull {
    margin-block: 1.75rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--e-rule);
    break-inside: avoid;
  }

  .pull p {
    font-family: var(--e-display);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    hyphens: none;
  }

  .qa {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 3px double var(--e-rule);
    break-inside: avoid-column;
  }

  .q {
    font-family: var(--e-display);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .q::before {
    content: 'D. ';
    color: var(--e-red);
  }

  .a::before {
    content: 'R. ';
    font-weight: 600;
  }

  .factsheet {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0 1rem;
    align-self: start;
    padding: 1rem;
    border: 1px solid var(--e-rule);
    background: rgb(255 255 255 / 0.35);
  }

  .portrait {
    grid-row: span 2;
    align-self: start;
    color: var(--e-ink);
    border: 1px solid var(--e-rule);
  }

  .factsheet-title {
    font-family: var(--e-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--e-red);
  }

  .fact {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.55rem;
    border-bottom: 1px dashed var(--e-hair);
    font-size: 0.9rem;
  }

  .fact dt {
    color: var(--e-muted);
  }

  .fact dd {
    font-weight: 600;
    text-align: right;
  }

  @media (min-width: 48rem) {
    .factsheet {
      grid-template-columns: 9rem 1fr;
      gap: 0 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: 1fr 18rem;
      gap: 3rem;
    }

    .body {
      columns: 2;
      column-gap: 2.5rem;
      column-rule: 1px solid var(--e-hair);
    }

    .pull {
      margin-top: 0;
    }

    .factsheet {
      position: sticky;
      top: 4.5rem;
      display: block;
    }

    .factsheet-title {
      margin-top: 0.9rem;
    }
  }
</style>
