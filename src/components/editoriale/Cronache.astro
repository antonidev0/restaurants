---
import type { EditorialeContent } from '@/data/editoriale';
import { pad } from '@/utils/format';

interface Props {
  briefs: EditorialeContent['briefs'];
  letters: EditorialeContent['letters'];
}

const { briefs, letters } = Astro.props;
---

<section id="cronache" class="cronache" aria-labelledby="cronache-title">
  <div class="e-wrap">
    <div class="e-section-head">
      <h2 id="cronache-title">Cronache di quartiere</h2>
      <span>Pagina 5</span>
    </div>

    <ol role="list" class="list">
      {
        briefs.map((brief, i) => (
          <li class="brief">
            <span class="index">{pad(i + 1)}</span>
            <h3 class="title">{brief.title}</h3>
            <p class="text">{brief.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="letters">
      <h3 class="letters-title">Lettere al direttore</h3>
      <div class="letters-grid">
        {
          letters.map((letter) => (
            <figure class="letter">
              <blockquote>
                <p>{letter.text}</p>
              </blockquote>
              <figcaption>— {letter.author}</figcaption>
              <p class="reply">
                <span>Risponde la cucina:</span> {letter.reply}
              </p>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cronache {
    padding-block: 2rem 3.5rem;
  }

  .e-section-head h2 {
    font: inherit;
  }

  .list {
    display: grid;
  }

  .brief {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--e-hair);
  }

  .index {
    grid-row: span 2;
    font-family: var(--e-display);
    font-size: 2.75rem;
    font-weight: 900;
    font-style: italic;
    line-height: 0.85;
    color: var(--e-red);
  }

  .title {
    font-family: var(--e-display);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .text {
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--e-muted);
  }

  .letters {
    margin-top: 2.5rem;
    padding: 1.25rem;
    background: var(--e-ink);
    color: var(--e-paper);
  }

  .letters-title {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgb(242 237 226 / 0.3);
    font-family: var(--e-display);
    font-size: 1.6rem;
    font-weight: 900;
    font-style: italic;
  }

  .letters-grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  .letter blockquote p {
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .letter blockquote p::before {
    content: '«';
  }

  .letter blockquote p::after {
    content: '»';
  }

  .letter figcaption {
    margin-top: 0.5rem;
    font-family: var(--e-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .reply {
    margin-top: 0.75rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--e-red);
    font-style: italic;
  }

  .reply span {
    font-family: var(--e-mono);
    font-size: 0.7rem;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #ff8a8f;
  }

  @media (min-width: 48rem) {
    .letters {
      padding: 2rem;
    }

    .letters-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .list {
      grid-template-columns: repeat(3, 1fr);
    }

    .brief {
      grid-template-columns: 1fr;
      padding: 1.75rem 1.5rem 0;
      border-bottom: 0;
    }

    .brief:first-child {
      padding-left: 0;
    }

    .brief + .brief {
      border-left: 1px solid var(--e-hair);
    }

    .index {
      grid-row: auto;
      font-size: 4rem;
      margin-bottom: 0.75rem;
    }
  }
</style>
