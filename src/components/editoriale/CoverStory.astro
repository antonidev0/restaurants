---
import type { EditorialeContent } from '@/data/editoriale';
import Engraving from './Engraving.astro';

interface Props {
  headline: EditorialeContent['headline'];
  numbers: EditorialeContent['numbers'];
}

const { headline, numbers } = Astro.props;
---

<section id="prima" class="cover" aria-labelledby="cover-title">
  <div class="e-wrap grid">
    <div class="copy">
      <p class="e-kicker">{headline.kicker}</p>
      <h1 id="cover-title" class="title">{headline.title}</h1>
      <p class="standfirst">{headline.standfirst}</p>
      <a class="more" href="#intervista">Continua a pagina 2 →</a>
    </div>

    <figure class="figure">
      <Engraving />
      <figcaption><span>Fig. 1</span> La carbonara della casa, servita come nel 1962.</figcaption>
    </figure>

    <dl class="numbers">
      {
        numbers.map((n) => (
          <div class="number">
            <dt>{n.label}</dt>
            <dd>{n.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .cover {
    padding-block: 1.75rem 3rem;
  }

  .grid {
    display: grid;
    gap: 2rem;
  }

  .copy {
    display: grid;
    gap: 1rem;
  }

  .title {
    font-family: var(--e-display);
    font-size: clamp(2.6rem, 12vw, 6.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.025em;
  }

  .standfirst {
    font-size: 1.15rem;
    line-height: 1.45;
    font-weight: 350;
  }

  .standfirst::first-line {
    font-weight: 600;
  }

  .more {
    width: fit-content;
    font-family: var(--e-mono);
    font-size: 0.8rem;
    text-decoration-color: var(--e-red);
    text-underline-offset: 4px;
  }

  .figure {
    color: var(--e-ink);
    border-block: 1px solid var(--e-rule);
    padding-block: 1rem 0.75rem;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-style: italic;
    color: var(--e-muted);
  }

  figcaption span {
    font-family: var(--e-mono);
    font-style: normal;
    color: var(--e-red);
    margin-right: 0.35rem;
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 3px double var(--e-rule);
    border-bottom: 1px solid var(--e-rule);
  }

  .number {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
    padding: 0.9rem 0.5rem;
    text-align: center;
  }

  .number + .number {
    border-left: 1px solid var(--e-hair);
  }

  dd {
    font-family: var(--e-display);
    font-size: clamp(1.9rem, 9vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
  }

  dt {
    font-family: var(--e-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--e-muted);
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: 7fr 5fr;
      gap: 2.5rem 3rem;
      align-items: start;
    }

    .copy {
      padding-right: 3rem;
      border-right: 1px solid var(--e-hair);
    }

    .standfirst {
      font-size: 1.35rem;
      max-width: 34ch;
    }

    .numbers {
      grid-column: 1 / -1;
    }
  }
</style>
