---
import '@fontsource/italiana';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource-variable/dm-sans';
import '@/styles/themes/aesthetic.css';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/aesthetic/Header.astro';
import Hero from '@/components/aesthetic/Hero.astro';
import Marquee from '@/components/aesthetic/Marquee.astro';
import Story from '@/components/aesthetic/Story.astro';
import Signature from '@/components/aesthetic/Signature.astro';
import MenuTabs from '@/components/aesthetic/MenuTabs.astro';
import Reviews from '@/components/aesthetic/Reviews.astro';
import Visit from '@/components/aesthetic/Visit.astro';
import Footer from '@/components/aesthetic/Footer.astro';
import { aesthetic as content } from '@/data/aesthetic';
---

<BaseLayout
  title={`${content.name} — Positano`}
  description={content.description}
  themeColor="#fbf4ec"
  theme="theme-aesthetic"
>
  <Header name={content.name} nav={content.nav} contact={content.contact} />
  <main id="contenuto">
    <Hero name={content.name} eyebrow={content.eyebrow} tagline={content.tagline} stickers={content.stickers} />
    <Marquee words={content.marquee} />
    <Story story={content.story} description={content.description} />
    <Signature dishes={content.signature} />
    <MenuTabs moments={content.moments} />
    <Reviews reviews={content.reviews} />
    <Visit hours={content.hours} contact={content.contact} directions={content.directions} />
  </main>
  <Footer name={content.name} contact={content.contact} />
</BaseLayout>
