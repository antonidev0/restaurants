---
import '@fontsource-variable/inter';

import BaseLayout from '@/layouts/BaseLayout.astro';
import { landings } from '@/data/landings';
import { pad } from '@/utils/format';
---

<BaseLayout
  title="Tre ristoranti, tre stili"
  description="Tre landing page di ristoranti italiani: minimalista, aesthetic ed editoriale."
  themeColor="#111111"
>
  <main id="contenuto" class="index">
    <header class="head">
      <p class="eyebrow">Ristoranti · Landing page</p>
      <h1>Tre ristoranti,<br />tre stili.</h1>
    </header>

    <ol role="list" class="list">
      {
        landings.map((landing, i) => (
          <li>
            <a class="card" href={landing.href}>
              <span class="num">{pad(i + 1)}</span>
              <span class="body">
                <span class="style">{landing.style}</span>
                <span class="name">
                  {landing.name} · {landing.city}
                </span>
                <span class="desc">{landing.description}</span>
              </span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>

<style>
  .index {
    min-height: 100svh;
    padding: 2.5rem 1.25rem;
    background: #111;
    color: #f4f2ee;
    font-family: 'Inter Variable', system-ui, sans-serif;
  }

  .head,
  .list {
    max-width: 48rem;
    margin-inline: auto;
  }

  .eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(2.5rem, 11vw, 5rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .list {
    margin-top: 3rem;
    border-top: 1px solid rgb(255 255 255 / 0.15);
  }

  .card {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: start;
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.15);
    text-decoration: none;
  }

  .num {
    font-size: 0.75rem;
    opacity: 0.5;
    padding-top: 0.4rem;
  }

  .body {
    display: grid;
    gap: 0.3rem;
  }

  .style {
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .name {
    font-size: 0.875rem;
    opacity: 0.8;
  }

  .desc {
    font-size: 0.875rem;
    opacity: 0.55;
  }

  .arrow {
    font-size: 1.5rem;
    transition: transform 0.2s ease;
  }

  .card:hover .arrow,
  .card:focus-visible .arrow {
    transform: translateX(4px);
  }

  .card:focus-visible {
    outline: 1px solid #f4f2ee;
    outline-offset: 4px;
  }
</style>
